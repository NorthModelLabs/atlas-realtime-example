# Copy only into the isolated Demo Atlas staging deployment in namespace
# atlas-staging. This points at the internal staging API Service, never prod.
ATLAS_API_URL=http://offline-api-staging.atlas-staging.svc.cluster.local:8200
ATLAS_ANIME_TARGET=atlas_staging
ATLAS_ANIME_API_URL=http://offline-api-staging.atlas-staging.svc.cluster.local:8200
ATLAS_ANIME_DEMO_ENABLED=false
ATLAS_ANIME_ENROLLMENT_ENABLED=false
ATLAS_ANIME_SESSION_ENABLED=false
ATLAS_ANIME_RASTER_JSON_UPLOAD_ENABLED=false
