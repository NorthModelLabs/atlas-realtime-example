# Required — Atlas session API
ATLAS_API_KEY=your_atlas_api_key
ATLAS_API_URL=https://api.atlasv1.com
# Optional — route realtime sessions to a specific Atlas model variant
# Use the deployment-approved routing alias; model identity is established by pinned runtime digests.
ATLAS_MODEL_VARIANT=test5

# Optional — enables AI chat responses (recommended for direct OpenAI)
OPENAI_API_KEY=your_openai_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional — enables voice (TTS) responses
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Required — server-only secret for browser ownership and viewer links (at least 32 characters)
DEMO_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
# Set to the exact public origin; local development uses http://localhost:3000
DEMO_PUBLIC_ORIGIN=http://localhost:3000
